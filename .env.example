# ShopShield - Environment Configuration

# Port configuration (Defaults to 3000)
PORT=3000

# Optional External Threat Intelligence APIs
# If omitted or left blank, ShopShield will gracefully skip reputation checks without penalizing the site.
# ShopShield does NOT require paid APIs to perform full DNS, TLS, RDAP, redirect, and content inspection.

# Google Safe Browsing API Key (Optional)
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API Key (Optional)
# https://www.virustotal.com/gui/user/apiKey
VIRUSTOTAL_API_KEY=
